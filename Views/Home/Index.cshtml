@model IEnumerable<CoachBookingApp.Models.Coach>

@{
    ViewData["Title"] = "Home Page";
}

<div class="hero position-relative text-center text-white mb-5" style="background:url('/images/hero.jpg') center/cover no-repeat; height:350px;">
    <div class="hero-overlay d-flex flex-column justify-content-center align-items-center h-100 bg-dark bg-opacity-50">
        <h1 class="display-4 fw-bold">CoachConnect</h1>
        <p class="lead">Boka en coach när det passar dig. Personlig utveckling, karriär och ledarskap.</p>
    </div>
</div>

<h2 class="mb-4 text-center">Våra coacher</h2>
<p class="lead text-center">Alla våra coacher är erfarna inom sitt område och hjälper dig att nå dina mål. Välj den coach som passar dig bäst och boka en tid direkt online.</p>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
@foreach (var coach in Model)
{
    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
            <img src="@coach.ImagePath" class="card-img-top" style="width:100%; height:auto;" alt="@coach.Name" />
            <div class="card-body d-flex flex-column">
                <h2 class="card-title">@coach.Name</h2>
                <h3 class="card-subtitle mb-2 text-muted">@coach.Title</h3>
                <p class="card-text flex-grow-1 text-truncate" style="max-height:3em; overflow:hidden;">@coach.Bio</p>

                @if (!User.Identity!.IsAuthenticated)
                {
                    <a asp-area="Identity"
                    asp-page="/Account/Login"
                    class="btn btn-outline-primary w-100">
                        Logga in för att boka
                    </a>
                }
                else if (User.IsInRole("User"))
                {
                    <a asp-controller="Bookings"
                    asp-action="SelectTime"
                    asp-route-coachId="@coach.Id"
                    class="btn btn-primary mt-auto w-100">
                        Boka
                    </a>
                }
                else if (User.IsInRole("Coach") || User.IsInRole("Admin"))
                {
                    <div class="alert alert-light text-center mb-0">
                        Bokning hanteras via dashboard
                    </div>
                }
            </div>
        </div>
    </div>
}
</div>
