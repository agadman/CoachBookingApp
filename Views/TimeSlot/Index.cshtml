@model IEnumerable<TimeSlot>
@using CoachBookingApp.Extensions

@{
    ViewData["Title"] = "Index";

    var isAdmin = User.IsInRole("Admin");
    var isCoach = User.IsInRole("Coach");
}

@if (isAdmin)
{
    <h1>Tider</h1>
}
else 
{
    <h1>Mina Tider</h1>
}

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.StartTime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EndTime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Coach)
            </th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model) {
                <tr>
                    <td>
                        @item.StartTime.ToSwedishTime()
                    </td>
                    <td>
                        @item.EndTime.ToSwedishTime()
                    </td>
                    <td>
                        @item.Coach?.Name
                    </td>
                    <td>
                        @if (item.Booking != null)
                        {
                            <span class="text-danger">Bokad</span>
                        }
                        else
                        {
                            <span class="text-success">Ledig</span>
                        }
                    </td>     
                    <td>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                            <span> | </span>
                        } 
                        <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
                </tr>
    }
    </tbody>
</table>
