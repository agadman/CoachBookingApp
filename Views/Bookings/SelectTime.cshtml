@model IEnumerable<CoachBookingApp.Models.TimeSlot>

<h2>Välj en tid för @ViewData["CoachName"]</h2>

@if (!Model.Any())
{
    <p>Inga lediga tider finns.</p>
}
else
{
   <table class="table">
    <thead>
        <tr>
            <th>Start</th>
            <th>Slut</th>
            <th>Boka</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var slot in Model)
        {
            <tr>
                <td>@slot.StartTime.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@slot.EndTime.ToString("HH:mm")</td>
                <td>
                    <form asp-controller="Bookings" asp-action="BookTimeSlot" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="timeSlotId" value="@slot.Id" />
                        <button type="submit" class="btn btn-success">Boka denna tid</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
}