@model IEnumerable<CoachBookingApp.Models.Booking>

@{
    ViewData["Title"] = "Mina bokningar";
}

<h1>Mina bokningar</h1>

@if (!Model.Any())
{
    <p>Du har inga bokningar just nu.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Coach</th>
                <th>Starttid</th>
                <th>Sluttid</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in Model)
            {
                <tr>
                    <td>@booking.TimeSlot?.Coach?.Name</td>
                    <td>@booking.TimeSlot?.StartTime.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@booking.TimeSlot?.EndTime.ToString("HH:mm")</td>
                    <td>@booking.Status</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@booking.Id" class="btn btn-sm btn-info">Detaljer</a>
                        <a asp-action="Delete" asp-route-id="@booking.Id" class="btn btn-sm btn-danger">Avboka</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}