@model IEnumerable<CoachBookingApp.Models.Booking>

@{
    ViewData["Title"] = "Index";

    var isAdmin = User.IsInRole("Admin");
    var isCoach = User.IsInRole("Coach");   
    var isUser = User.IsInRole("User");
}

@if (isAdmin)
{
    <h1>Bokningar</h1>
}
else 
{
    <h1>Mina Bokningar</h1>
}


@if (isAdmin || isCoach)
{
    <p>
        <a asp-action="Create">Skapa ny bokning</a>
    </p>
}

<table class="table">
    <thead>
        <tr>
            @if (isUser)
            {
                <th>Coach</th>
            }

            @if (isCoach)
            {
                <th>Kund</th>
                <th>Email</th>
            }

            @if (isAdmin)
            {
                <th>Kund</th>
                <th>Email</th>
                <th>Coach</th>
            }

            <th>Dag & Tid</th>
            <th>Status</th>
            <th>Bokade den</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            @if (isUser)
            {
                <td>@item.TimeSlot?.Coach?.Name</td>
            }

            @if (isCoach)
            {
                <td>@item.CustomerName</td>
                <td>@item.CustomerEmail</td>
            }

            @if (isAdmin)
            {
                <td>@item.CustomerName</td>
                <td>@item.CustomerEmail</td>
                <td>@item.TimeSlot?.Coach?.Name</td>
            }

            <td>
                @(item.TimeSlot != null
                    ? item.TimeSlot.StartTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                    : "")
            </td>

            <td>@item.Status</td>

            <td>@item.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>

            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |

                @if (isAdmin || (isUser && item.UserId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value))
                {
                    <form asp-action="Cancel" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="btn btn-link p-0 m-0 align-baseline">Cancel</button>
                    </form>
                }
            </td>

        </tr>
    }
    </tbody>
</table>