@model IEnumerable<CoachBookingApp.Models.Booking>
@using CoachBookingApp.Extensions

@{
    ViewData["Title"] = "Index";

    var isAdmin = User.IsInRole("Admin");
    var isCoach = User.IsInRole("Coach");   
    var isUser = User.IsInRole("User");

    var sortedBookings = Model.OrderBy(b => b.TimeSlot?.StartTime).ToList();
    var booked = sortedBookings.Where(b => b.Status == "Booked").ToList();
    var otherStatuses = sortedBookings.Where(b => b.Status != "Booked").ToList();
}

@if (isAdmin)
{
    <h1>Bokningar</h1>
}
else 
{
    <h1>Mina Bokningar</h1>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}
<!-- Här är de aktiva bokningarna (ej genomförda) -->
<div class="d-flex justify-content-between align-items-center mt-5">
    <h3>Aktiva bokningar</h3>
    @if (isAdmin || isCoach) 
    {
        <a asp-action="Create" class="btn btn-primary" title="Skapa ny bokning">
            <i class="fas fa-plus"></i>
        </a>
    }
</div>

@if (booked.Any())
{
    <table class="table">
        <thead>
            <tr>
                @if (isUser)
                {
                    <th>Coach</th>
                }

                @if (isCoach)
                {
                    <th>Kund</th>
                    <th>Email</th>
                }

                @if (isAdmin)
                {
                    <th>Kund</th>
                    <th>Email</th>
                    <th>Coach</th>
                }

                <th>Starttid</th>
                <th>Sluttid</th>
                <th>Status</th>
                <th class="text-end"></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in booked)
        {
            <tr>
                @if (isUser)
                {
                    <td>@item.TimeSlot?.Coach?.Name</td>
                }

                @if (isCoach)
                {
                    <td>@item.CustomerName</td>
                    <td>@item.CustomerEmail</td>
                }

                @if (isAdmin)
                {
                    <td>@item.CustomerName</td>
                    <td>@item.CustomerEmail</td>
                    <td>@item.TimeSlot?.Coach?.Name</td>
                }

                    <td>
                        @(item.TimeSlot != null 
                            ? item.TimeSlot.StartTime.ToSwedishTime() 
                            : "")
                    </td>

                    <td>
                        @(item.TimeSlot != null 
                            ? item.TimeSlot.EndTime.ToSwedishTime() 
                            : "")
                    </td>

                <td>@item.Status</td>

                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@item.Id" class="ms-2">Details</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <p>Inga aktiva bokningar.</p>
}

<!-- Här är de tidigare bokningarna (status: Cancelled, NoShow, completed) -->
<h3 class="mt-5">Arkiverade bokningar</h3>

@if (otherStatuses.Any())
{
    <table class="table table-sm">
        <thead>
            <tr>
                @if (isUser)
                {
                    <th>Coach</th>
                }

                @if (isCoach)
                {
                    <th>Kund</th>
                    <th>Email</th>
                }

                @if (isAdmin)
                {
                    <th>Kund</th>
                    <th>Email</th>
                    <th>Coach</th>
                }

                <th>Starttid</th>
                <th>Sluttid</th>
                <th>Status</th>
                <th class="text-end"></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in otherStatuses)
        {
            <tr class=" table-light text-muted">
                @if (isUser)
                {
                    <td>@item.TimeSlot?.Coach?.Name</td>
                }

                @if (isCoach)
                {
                    <td>@item.CustomerName</td>
                    <td>@item.CustomerEmail</td>
                }

                @if (isAdmin)
                {
                    <td>@item.CustomerName</td>
                    <td>@item.CustomerEmail</td>
                    <td>@item.TimeSlot?.Coach?.Name</td>
                }

                <td>
                    @(item.TimeSlot != null 
                        ? item.TimeSlot.StartTime.ToSwedishTime() 
                        : "")
                </td>

                <td>
                    @(item.TimeSlot != null 
                        ? item.TimeSlot.EndTime.ToSwedishTime() 
                        : "")       
                </td>

                <td>@item.Status</td>

                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@item.Id" class="ms-2">Details</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <p>Inga tidigare bokningar.</p>
}